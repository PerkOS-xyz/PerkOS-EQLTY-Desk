# Copy to .env next to compose.yml on the host. Never commit .env.
# Leave a line empty to keep the default in src/config.ts.

# The Uniswap Trading API key. Without it /quote and /swap answer 503.
UNISWAP_API_KEY=

# UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
# Who a read-only quote is priced for. A swap always uses the real wallet.
# UNISWAP_QUOTE_SWAPPER=0x000000000000000000000000000000000000dEaD
# Where token decimals are read. It must answer chain id 4663.
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Per-order ceilings in atomic USDG (6 decimals): 100000000 is 100 USDG.
# EQLTY_AGENT_SWAP_MAX_AMOUNT=100000000
# EQLTY_AGENT_QUOTE_MAX_AMOUNT=100000000

# EQLTY_API_URL=https://eqlty-api.perkos.xyz
# PERKOS_DESK_NETWORK=perkos-knowledge_default
